{
  "//": "Workspace root. This package is private and never published — it only orchestrates the monorepo (apps/* and packages/*) via pnpm workspaces + Turborepo. Individual deployables live in apps/.",
  "name": "ai-creator-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "//": "Turborepo fans these scripts out to every workspace that defines them, with caching.",
    "predev": "pnpm --filter @hub/db generate && pnpm --filter \"@hub/shared\" --filter \"@hub/db\" --filter \"@hub/providers\" build",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @hub/db generate",
    "db:migrate": "pnpm --filter @hub/db migrate:dev",
    "db:studio": "pnpm --filter @hub/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.3"
  }
}
