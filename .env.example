# =============================================================================
# AI Creator Hub — environment template.
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is git-ignored).
# Every secret lives ONLY in the backend/worker runtime — never in the browser
# bundle. Anything the frontend legitimately needs is prefixed NEXT_PUBLIC_.
# =============================================================================

# ---- Core ----
NODE_ENV=development
# Public base URLs (used for OAuth callbacks, links in emails, CORS).
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- PostgreSQL (Prisma) ----
# Matches the docker-compose service. In prod, use a managed Postgres URL.
DATABASE_URL=postgresql://hub:hub@localhost:5432/creatorhub?schema=public

# ---- Redis (BullMQ queues, cache, rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Auth.js) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
# OAuth providers (create apps in each provider's console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Object storage (S3-compatible; MinIO in local dev) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=creatorhub
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Force path-style for MinIO; false for real AWS S3.
S3_FORCE_PATH_STYLE=true

# ---- AI providers (backend/worker only) ----
# Flagship text generation. Swap/extend per feature in Phase 6.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Speech-to-text / text-to-speech provider keys.
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_API_KEY=
# Image generation.
IMAGE_API_KEY=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key is the only Stripe value allowed in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---- Transactional email ----
EMAIL_FROM=hello@aicreatorhub.app
SMTP_URL=

# ---- Frontend public config ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
