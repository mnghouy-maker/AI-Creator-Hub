# pnpm settings for the monorepo.
# link-workspace-packages: resolve @hub/* to local source, not the registry.
# save-workspace-protocol: record internal deps as workspace:* so they never
# accidentally pull a published version.
link-workspace-packages=true
save-workspace-protocol=rolling
# NestJS + Prisma have peer deps that are safe to auto-install.
auto-install-peers=true
